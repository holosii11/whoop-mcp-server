# From your app in the WHOOP Developer Dashboard (developer.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Must exactly match a redirect URI registered on your WHOOP app, e.g.
# https://your-app.onrender.com/oauth/callback
WHOOP_REDIRECT_URI=

# The public hostname this server is deployed at (no protocol), e.g.
# your-app.onrender.com — used to validate incoming request Host headers.
# Leave blank only for local testing.
PUBLIC_HOST=

# Port to listen on. Most hosting platforms set this automatically.
PORT=3000

# Optional: where to persist WHOOP tokens on disk.
# TOKENS_PATH=./data/tokens.json
